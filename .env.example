# Copy to .env and edit. Everything is optional.

# Port and interface (0.0.0.0 = reachable from other devices on your network)
PORT=8080
HOST=0.0.0.0

# The address phones use to reach this server. Empty = detect from the browser.
# Home network:  PUBLIC_URL=http://192.168.1.50:8080
# With a tunnel: PUBLIC_URL=https://calendar.example.com
PUBLIC_URL=

# Behind a tunnel / reverse proxy (Cloudflare Tunnel, Caddy, nginx…): set to 1 = trust exactly
# one proxy hop. Then also set HOST=127.0.0.1 so the app is ONLY reachable through that proxy —
# otherwise anyone could connect directly and fake their IP address.
TRUST_PROXY=0

# Where the database, secret key and backups live
# DATA_DIR=./data

# Logging: trace, debug, info, warn, error, silent
# LOG_LEVEL=info

# Hebcal REST API (holidays & candle-lighting extras)
# HEBCAL_API_BASE=https://www.hebcal.com
# HEBCAL_REFRESH_HOURS=12
